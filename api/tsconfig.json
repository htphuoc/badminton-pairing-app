{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": ["es2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "typeRoots": ["../node_modules/@types", "../server/@types"]
  },
  "include": ["./**/*.ts", "../server/**/*.ts"]
}
